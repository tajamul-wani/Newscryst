# Currents API key (https://currentsapi.services). Server-side only: no VITE_ prefix,
# so it is never bundled into the browser code.
# Local dev: copy to .env.local. Production: set CURRENTS_API_KEY in Netlify
# (Site settings -> Environment variables).
CURRENTS_API_KEY=your_currents_api_key_here

# .env.local is ignored by git and should not be committed.
